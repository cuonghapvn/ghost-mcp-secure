# ghost-mcp-secure — environment template
# Copy to .env (cp .env.example .env) and fill in real values.
# NEVER commit your real .env — it grants admin access to your Ghost site.

# ---- Required ----
# Your Ghost site base URL (no trailing slash needed)
GHOST_API_URL=https://your-blog.example.com

# Ghost Admin API key, format id:secret
# Ghost Admin → Settings → Integrations → Add custom integration → copy "Admin API Key"
GHOST_ADMIN_API_KEY=<id>:<secret>

# ---- Optional ----
# Ghost Admin API version (default v6.0)
GHOST_API_VERSION=v6.0

# ---- Privilege flags (all default false = secure / read-only) ----
# Enable each only for sessions where you actually need it.

# Create/update posts, pages, tags; upload images & themes
GHOST_WRITE_ENABLED=false

# Allow setting content status to published / scheduled
GHOST_ALLOW_PUBLISH=false

# Allow delete tools (irreversible)
GHOST_ALLOW_DELETE=false

# Member management (contains PII)
GHOST_ALLOW_MEMBERS=false

# Tiers / offers / newsletters
GHOST_ALLOW_MONETIZATION=false

# Settings / webhooks / users / themes (highest privilege)
GHOST_ALLOW_SYSTEM=false
